# -----------------------------------------------------------------------------
# Abizon — environment
#
# Copy to `.env.local` for development. `.env.local` is gitignored and must
# stay that way; nothing in this file is a real secret.
#
# `src/lib/env.ts` validates all of this. In production a missing required
# variable is fatal at first use, with a message naming what breaks without it.
# In development almost everything degrades to a documented local mode and says
# so on the terminal — a fresh clone with no `.env.local` must still start, or
# the 150 destination pages become unworkable for anyone doing front-end work.
#
# `/api/health` reports which of these are configured, read from the same
# capability checks the code branches on.
# -----------------------------------------------------------------------------


# =============================================================================
# SESSIONS AND ONE-TIME CODES
# =============================================================================

# Signs applicant session cookies and keys the HMAC over one-time codes.
#
# Generate:  openssl rand -base64 32
#
# Required in production. Rotating it signs every applicant out and invalidates
# every code in flight, which is the correct response to a suspected leak — and
# is why the ops console has its own secret further down, so that rotating this
# does not also lock out the people handling the incident.
AUTH_SECRET=

# Keeps inline Server Action closures decryptable across instances and deploys.
# Without it, a multi-instance deployment can fail an action mid-submit with
# "Failed to find Server Action". Generate the same way.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=


# =============================================================================
# DATABASE — Supabase Postgres, ap-south-1 (Mumbai)
# =============================================================================
#
# TWO URLs, AND THEY ARE NOT INTERCHANGEABLE.
#
#   DATABASE_URL   Supavisor transaction pooler, port 6543. What the app runs
#                  on. Serverless opens and abandons connections faster than
#                  Postgres retires them, so a direct connection exhausts the
#                  pool under mild load.
#
#   DIRECT_URL     Direct connection, port 5432. Migrations only — DDL needs a
#                  session, which the transaction pooler does not give you.
#                  `drizzle-kit` against 6543 appears to hang and then fails
#                  without mentioning pooling.
#
# `lib/db/client.ts` sets `prepare: false` because transaction pooling does not
# support prepared statements. That is not a tuning choice; without it,
# production starts throwing `prepared statement "s1" does not exist` under
# concurrency while every test passes.
#
# Absent: the app falls back to the in-memory auth store, which is correct on
# one long-lived dev server and silently wrong on serverless. Required in
# production.

DATABASE_URL=
DIRECT_URL=


# =============================================================================
# FIELD ENCRYPTION
# =============================================================================

# Encrypts passport numbers, dates of birth and staff TOTP secrets, and derives
# the blind-index key used to search for a passport without storing it.
#
# Generate:  openssl rand -base64 32   (must decode to exactly 32 bytes)
#
# DELIBERATELY SEPARATE FROM AUTH_SECRET. Rotating the session secret is a
# routine response to a suspected cookie leak, and it must not also be a
# decision about whether historical passport numbers stay readable.
#
# Absent: writing traveller details is refused outright rather than falling back
# to plaintext. It is the one degraded mode this codebase does not offer,
# because its failure would be invisible and permanent.
DATA_ENCRYPTION_KEY=

# Retired keys, newest first, comma-separated. Rotating means moving the old
# current key to the front of this list and putting the new one above. Old rows
# keep decrypting; new writes use the new key; `key_version` on each row records
# which. Nothing re-encrypts automatically — that is a job somebody runs.
#
# Note: rotating invalidates every blind index, which the re-encryption job has
# to rebuild.
DATA_ENCRYPTION_KEY_PREVIOUS=


# =============================================================================
# DOCUMENTS — Supabase Storage
# =============================================================================
#
# Two private buckets, created by migration `0001_storage_buckets.sql`:
#
#   incoming    raw camera output. Read by exactly one thing — the normaliser —
#               and emptied daily by the purge job.
#   documents   re-encoded by sharp, EXIF stripped. What everyone else sees.
#
# The browser uploads directly to a signed URL; the file never passes through a
# function. Reads are sixty-second signed URLs minted per view.

SUPABASE_URL=

# SERVER ONLY. Bypasses row-level security. It must never appear in a
# NEXT_PUBLIC_ variable, a client component, or anything that reaches a browser.
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# SMS
# =============================================================================

# Which driver carries one-time codes: `console`, `memory` or `msg91`.
#
# `console` prints the code to the server terminal and sends nothing. It throws
# if selected in production, so a misconfigured deploy fails loudly instead of
# writing every login code into the application log.
#
# `memory` hands the code back to the caller instead of printing it. It exists
# for the test suite and refuses to run in production.
SMS_PROVIDER=console

# -----------------------------------------------------------------------------
# MSG91 — required only when SMS_PROVIDER=msg91
#
# BEFORE THESE WORK: the sender header and the message template must be
# registered and approved on the TRAI DLT portal, under the client's own
# business entity. Unregistered traffic to Indian numbers is dropped by the
# carrier without an error — the API call succeeds and the SMS never arrives.
# Budget days, not hours, and start it early.
# -----------------------------------------------------------------------------

# Account credential from the MSG91 dashboard.
MSG91_AUTH_KEY=

# The approved six-character alphabetic header, e.g. ABIZON.
MSG91_SENDER_ID=

# Id of the DLT-approved template. Its variables must be named OTP and EXPIRY
# to match `lib/auth/sms/msg91.ts`, or the send is rejected.
MSG91_DLT_TEMPLATE_ID=


# =============================================================================
# BOT PROTECTION — Cloudflare Turnstile
# =============================================================================
#
# Guards the send-code action, which is a public endpoint that spends the
# client's money: roughly ₹0.15 an SMS, and a script working through a list of
# numbers never trips the per-number limit.
#
# Free at any volume this site will see. The site key is public by design; the
# secret is not.
#
# Required in production. To switch the check off deliberately rather than by
# forgetting, set the secret to the literal string `disabled`.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# =============================================================================
# RATE LIMITING — Upstash Redis
# =============================================================================
#
# Per-IP ceilings on the endpoints that cost something. Optional: without it the
# limiter counts in process memory, which on serverless means each instance
# counts separately and the real allowance is the stated limit times the
# instance count. It warns loudly when it does this.
#
# The per-number OTP ceiling is in Postgres and does not depend on this.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =============================================================================
# EMAIL — Resend
# =============================================================================
#
# BEFORE THE FIRST REAL MESSAGE: SPF, DKIM and DMARC on the sending domain.
# Transactional mail from a fresh domain without them lands in spam, and
# "the applicant never got the email" then looks identical to "the application
# vanished".
#
# Absent: messages are printed to the terminal rather than dropped, and every
# attempt is recorded in `email_log` either way.

RESEND_API_KEY=

# e.g. `Abizon <applications@abizon.com>`. Must be a verified domain in Resend.
EMAIL_FROM=

# Where "reply to a human" goes. Optional.
EMAIL_REPLY_TO=


# =============================================================================
# SCHEDULED WORK
# =============================================================================

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`.
#
# Required in production. These endpoints delete documents and purge tables, on
# predictable URLs — without the secret they are public buttons for destroying
# data. An unauthorised call gets a 404, not a 401.
CRON_SECRET=


# =============================================================================
# OPS CONSOLE
# =============================================================================

# Signs staff session cookies. Separate from AUTH_SECRET on purpose: see the
# note there. Generate the same way.
#
# There is no development fallback for this one. An unauthenticated path into a
# passport viewer is not worth the convenience.
OPS_SESSION_SECRET=


# =============================================================================
# OBSERVABILITY
# =============================================================================

# Sentry. The DSN is a write-only endpoint and is not a secret.
#
# `instrumentation.ts` scrubs request bodies, cookies, headers and console
# breadcrumbs before anything is sent — those paths carry phone numbers, codes
# and passport numbers, and an error tracker holding them is a second copy of
# the database in somebody else's account.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog. Autocapture is disabled on /apply, /login, /profile, /track and /ops,
# and session replay is disabled everywhere — replay records what is typed, and
# on this site that is a passport number.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# =============================================================================
# SITE
# =============================================================================

# Absolute origin, used in emails and signed links where a relative URL is
# meaningless. On Vercel this falls back to the deployment's own hostname, which
# is right for previews — a preview's emails should link back to the preview.
SITE_URL=http://localhost:3000
