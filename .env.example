# -----------------------------------------------------------------------------
# Abizon — environment
#
# Copy to `.env.local` for development. `.env.local` is gitignored and must
# stay that way; nothing in this file is a real secret.
# -----------------------------------------------------------------------------

# Signs session cookies and keys the HMAC over one-time codes.
#
# Generate:  openssl rand -base64 32
#
# Required in production — the app refuses to start without it rather than
# falling back to a known development value. Rotating it signs everyone out and
# invalidates every code in flight, which is the correct behaviour for a
# suspected leak.
AUTH_SECRET=

# Which SMS driver carries one-time codes: `console` or `msg91`.
#
# `console` prints the code to the server terminal and sends nothing. It throws
# if selected in production, so a misconfigured deploy fails loudly instead of
# writing every login code into the application log.
SMS_PROVIDER=console

# -----------------------------------------------------------------------------
# MSG91 — required only when SMS_PROVIDER=msg91
#
# BEFORE THESE WORK: the sender header and the message template must be
# registered and approved on the TRAI DLT portal, under the client's own
# business entity. Unregistered traffic to Indian numbers is dropped by the
# carrier without an error — the API call succeeds and the SMS never arrives.
# Budget days, not hours, and start it early.
# -----------------------------------------------------------------------------

# Account credential from the MSG91 dashboard.
MSG91_AUTH_KEY=

# The approved six-character alphabetic header, e.g. ABIZON.
MSG91_SENDER_ID=

# Id of the DLT-approved template. Its variables must be named OTP and EXPIRY
# to match `lib/auth/sms/msg91.ts`, or the send is rejected.
MSG91_DLT_TEMPLATE_ID=
