# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright. The report and the traces are build output — regenerated by any
# run and large enough (traces carry screenshots of every step) to be worth
# keeping out. CI uploads them as an artifact on failure instead.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# design reference captures — ~19MB of screenshots/recordings used to spec the
# redesign. Kept on disk for reference, out of the repo.
/image_video/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ...but the template is documentation, not a secret, and is the only record of
# which variables the app needs. It must reach whoever deploys this.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OCR engine assets, placed by `scripts/setup-tesseract.mjs` before dev and
# build. Reproducible from the lockfile and a pinned URL, so they are fetched
# rather than committed — 8MB of binaries is paid for on every clone forever.
public/tesseract/

# Reference material dropped in the repo root by the product owner.
/payment v2.zip
