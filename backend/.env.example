# -----------------------------------------------------------------------------
# Abizon backend — environment
#
# Copy to `backend/.env` for running outside Docker. docker-compose.yml sets
# local values itself; on EC2 these live in `/srv/abizon/env/backend.env`,
# written from SSM Parameter Store, never committed.
#
# Validated by app/core/config.py. In production a missing required value stops
# the process at startup with a message naming what breaks. A blank line
# (`KEY=`) counts as unset.
# -----------------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# JSON list. The hostnames the API answers to inside the Docker network.
ALLOWED_HOSTS=["api", "localhost", "127.0.0.1"]


# --- Database: RDS Postgres ----------------------------------------------------
# Must use the async driver. This service owns schema `svc` only.
# Required in production.
DATABASE_URL=postgresql+asyncpg://abizon:abizon@localhost:5432/abizon
DATABASE_POOL_SIZE=5


# --- Redis: rate limits and the Celery broker ------------------------------------
# Required in production. Without it limits count per process and Celery has
# no broker.
REDIS_URL=redis://localhost:6379/0
# Optional; defaults to REDIS_URL.
CELERY_BROKER_URL=


# --- Service-to-service authentication -------------------------------------------
# The SAME value as SERVICE_JWT_SECRET in the web app's environment. The web app
# signs a 60-second token per call; this service verifies it.
#
# Generate:  openssl rand -base64 48
#
# Separate from AUTH_SECRET and OPS_SESSION_SECRET on purpose. Required in
# production, at least 32 characters.
SERVICE_JWT_SECRET=


# --- AWS -------------------------------------------------------------------------
# NO ACCESS KEYS. On EC2 boto3 uses the instance role (infra/aws/iam-policy.json).
# Locally it uses ~/.aws/credentials or AWS_PROFILE.
AWS_REGION=ap-south-1

# The private documents bucket. Required in production.
S3_BUCKET=

# Only for a local S3 stand-in (docker-compose uses moto). Leave blank on AWS.
S3_ENDPOINT_URL=

UPLOAD_URL_TTL_SECONDS=300
VIEW_URL_TTL_SECONDS=60
MAX_UPLOAD_BYTES=15728640
INCOMING_MAX_AGE_SECONDS=3600

# Claude on Bedrock. Model access must be enabled for this account and region
# in the Bedrock console before the first call, or every job fails with 403.
BEDROCK_REGION=
BEDROCK_MODEL=anthropic.claude-opus-5
AI_MAX_OUTPUT_TOKENS=16000


# --- Scheduled calls into the web app --------------------------------------------
# Celery beat calls the web app's /api/cron/purge and /api/cron/retention, which
# used to be Vercel Cron. Both required in production.
WEB_INTERNAL_URL=http://localhost:3000
# The SAME value as CRON_SECRET in the web app's environment.
CRON_SECRET=
